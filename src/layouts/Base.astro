---
import '../styles/global.css';
import { SITE } from '../site';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description = SITE.tagline, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/projects', label: 'Projects' },
  { href: '/articles', label: 'Writing' },
  { href: '/about', label: 'About' },
];
const current = (href: string) => path.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1012" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Persisted light/dark choice; defaults to the OS preference. Runs before paint.
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">Eric Mey<span>.</span></a>
        <nav class="main" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
          <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" id="theme-toggle">◐</button>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <nav aria-label="Elsewhere">
          <a href={SITE.links.github}>GitHub</a>
          <a href={SITE.links.huggingface}>Hugging Face</a>
          {SITE.links.linkedin && <a href={SITE.links.linkedin}>LinkedIn</a>}
          {SITE.links.email && <a href={`mailto:${SITE.links.email}`}>Email</a>}
        </nav>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        var sync = function () { btn.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark')); };
        sync();
        btn.addEventListener('click', function () {
          var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          sync();
        });
      })();
    </script>
  </body>
</html>
