---
import type { CollectionEntry } from 'astro:content';
interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const { title, summary, date, venue, url } = article.data;
const href = url ?? `/articles/${article.id}`;
const day = date.toISOString().slice(0, 10);
---
<article class="card">
  <h3><a href={href}>{title}</a></h3>
  <p>{summary}</p>
  <div class="meta"><time datetime={day}>{day}</time> · {venue}</div>
</article>
