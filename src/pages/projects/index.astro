---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" description="Systems I have built, each with links to the code and the evidence behind its claims.">
  <div class="wrap">
    <header class="page-head">
      <h1>Projects</h1>
      <p class="lede">Each project links to its code, and to the evidence behind any claim it makes.</p>
    </header>
    <div class="grid">{projects.map((p) => <ProjectCard project={p} level={2} />)}</div>
  </div>
</Base>
