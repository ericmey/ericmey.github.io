---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" description="Public AI projects with code, documentation and evidence you can inspect.">
  <div class="wrap">
    <header class="page-head banner banner-projects">
      <h1>Projects</h1>
      <p class="lede">Independent, public work. Each project links to the code and evidence behind its claims.</p>
    </header>
    <div class="grid">{projects.map((p) => <ProjectCard project={p} level={2} />)}</div>
  </div>
</Base>
